# Copy to .env.local

# Clerk. Leave both empty to run with the built-in demo sign-in (role picker, no real auth).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# FastAPI backend. Data is read from here through the adapter layer in src/lib/adapters.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to true to use the bundled mock API instead of the backend (no backend needed).
NEXT_PUBLIC_USE_MOCK=false
