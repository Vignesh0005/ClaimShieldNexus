# Copy to .env. Blank values mean "not configured" and switch on the documented fallback.

# development | test | production
ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Database. Unset uses a local SQLite file (development only; production refuses SQLite).
# Leave commented out to use SQLite.
# DATABASE_URL=postgresql+asyncpg://claimshield:CHANGE_ME@localhost:5432/claimshield

# Redis. Blank: in-process cache, and detection runs inside the API process instead of Celery.
REDIS_URL=

# ML model server on the training machine. Blank: score with local artifacts in ARTIFACTS_DIR.
ML_SERVER_URL=
ML_SERVER_TIMEOUT=10
ML_FALLBACK_ENABLED=true
ARTIFACTS_DIR=artifacts

# Investigation copilot (Ollama Cloud). Blank key: explanations use the deterministic template.
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b

# Event-driven ingestion (optional). Credentials come from the standard AWS environment or role.
AWS_REGION=us-east-1
SQS_QUEUE_URL=
SNS_TOPIC_ARN=

# Auth. Uncomment JWT_SECRET and set a long random value (required when ENV=production). To verify Clerk tokens instead, set the JWKS URL.
# JWT_SECRET=generate-with: python -c "import secrets; print(secrets.token_urlsafe(48))"
CLERK_JWKS_URL=
CLERK_ISSUER=

SENTRY_DSN=

ENABLE_GRAPH_ANALYTICS=true
ENABLE_TEMPORAL_ANALYTICS=true
ENABLE_COPILOT=true
ENABLE_FAISS=true

CASE_RISK_THRESHOLD=0.7
RETRAIN_THRESHOLD=100
RATE_LIMIT_PER_MINUTE=600
